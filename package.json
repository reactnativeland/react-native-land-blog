{
  "name": "react-native-land-blog",
  "version": "0.1.0",
  "type": "module",
  "description": "A blog about React Native development",
  "author": "React Native Land",
  "repository": {
    "type": "git",
    "url": "https://github.com/reactnativeland/react-native-land-blog.git"
  },
  "homepage": "https://reactnative.land/",
  "keywords": [
    "react",
    "react-native",
    "blog",
    "mdx",
    "tailwindcss"
  ],
  "dependencies": {
    "@unhead/react": "^2.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^3.21.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "feed": "^5.2.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "shiki": "^3.21.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-rss.js && node scripts/generate-sitemap.js && vite build",
    "preview": "vite preview",
    "analyze": "vite build && open dist/stats.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,mdx}\"",
    "prepare": "husky"
  }
}
